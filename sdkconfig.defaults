# Target and flash layout for the ESP32-S3 N16R8 (16 MB flash, 8 MB PSRAM).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM is not needed by this firmware and is left off, so the image also boots
# on N16R2/N8 modules. To enable it on an N16R8 (octal PSRAM):
#   CONFIG_SPIRAM=y
#   CONFIG_SPIRAM_MODE_OCT=y

# USB host: the OTG peripheral is driven by the USB Host Library, so the
# console must stay on the UART bridge rather than the native USB port.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# GPIO19/20 are shared with the USB-Serial-JTAG controller. The USB Host
# Library takes over the PHY, so the secondary console must be disabled.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
