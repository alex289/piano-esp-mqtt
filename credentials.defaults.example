# Copy to "credentials.defaults" and fill in. That file is gitignored and the
# build picks it up automatically; no menuconfig needed.
#
#   cp credentials.defaults.example credentials.defaults

CONFIG_PIANO_WIFI_SSID="MyWiFi"
CONFIG_PIANO_WIFI_PASSWORD="secret"

# Host and port of the MQTT broker, e.g. the machine running the Mosquitto
# container. Use its IP if mDNS (.local) is unreliable on your network.
CONFIG_PIANO_MQTT_URI="mqtt://192.168.1.50:1883"

# Leave both empty for a broker that allows anonymous access -- that is the
# case for Mosquitto started with "mosquitto -c /mosquitto-no-auth.conf".
CONFIG_PIANO_MQTT_USERNAME=""
CONFIG_PIANO_MQTT_PASSWORD=""
